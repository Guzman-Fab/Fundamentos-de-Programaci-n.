#include <iostream>
using namespace std;

// Prototipos de funciones
float cubo(float n);
int calcularmenor(int a, int b);
int signo(float a);

int main() {
    float b, f;
    float a, d; // Declaradas de manera clara
    int opcion, x;

    do {
        cout << "\t\t Menu \n";
        cout << "\t\t ==== \n";
        cout << "1. Calcular el cubo\n";
        cout << "2. Calcular el menor\n";
        cout << "3. Calcular el signo de un numero\n";
        cout << "0. Salir\n";
        cout << "Opcion: ";
        cin >> opcion;

        switch (opcion) {
        case 1:
            cout << "Ingresar el numero: ";
            cin >> b;
            a = cubo(b);
            cout << "El resultado es: " << a << "\n\n";
            break;
        case 2: {
            int n1, n2; // Usamos enteros para la función de menor
            cout << "Ingresa el primer numero entero: ";
            cin >> n1;
            cout << "Ingrese el segundo numero entero: ";
            cin >> n2;
            d = calcularmenor(n1, n2);
            cout << "El menor es: " << d << "\n\n";
            break;
        }
        case 3:
            cout << "Ingrese el numero: ";
            cin >> f;
            x = signo(f);
            cout << "El resultado es: " << x << "\n\n";
            break;
        case 0:
            cout << "Saliendo del menu...\n";
            break;
        default:
            cout << "Error de opcion.\n\n";
            break;
        }

        if (opcion != 0) {
            system("pause");
            system("cls");
        }
    } while (opcion != 0);

    return 0;
}

float cubo(float n) {
    return n * n * n;
}

int calcularmenor(int a, int b) {
    if (a < b)
        return a;
    else
        return b;
}

int signo(float a) {
    if (a > 0) {
        return 1;
    }
    else if (a < 0) {
        return -1;
    }
    else {
        return 0;
    }
}
