    cout << "\n--- LISTA DE PERSONAS ---" << endl;

    if (personas.empty()) {

        cout << "No existen personas registradas." << endl;
    }
    else {

        for (int i = 0; i < personas.size(); i++) {

            cout << "\nPersona Nro: " << i + 1 << endl;
            cout << "Nombre: " << personas[i].nombre << endl;
            cout << "Fecha de nacimiento: " << personas[i].fecha << endl;
            cout << "CI: " << personas[i].ci << endl;
            cout << "Direccion: " << personas[i].direccion << endl;
            cout << "Telefono: " << personas[i].telefono << endl;
        }
    }
}


// BORRAR PERSONA
void borrar_persona() {

    cout << "\n--- BORRAR PERSONA ---" << endl;

    string ci;

    cout << "Ingrese el CI: ";
    getline(cin, ci);

    for (int i = 0; i < personas.size(); i++) {

        if (personas[i].ci == ci) {

            personas.erase(personas.begin() + i);

            cout << "Persona eliminada correctamente." << endl;
            return;
        }
    }

    cout << "Persona no encontrada." << endl;
}


// MODIFICAR PERSONA
void modificar_persona() {

    cout << "\n--- MODIFICAR PERSONA ---" << endl;

    string ci;

    cout << "Ingrese el CI de la persona: ";
    getline(cin, ci);

    for (int i = 0; i < personas.size(); i++) {

        if (personas[i].ci == ci) {

            cout << "Nuevo nombre: ";
            getline(cin, personas[i].nombre);

            string fecha;

            cout << "Nueva fecha de nacimiento (DD/MM/AAAA): ";
            getline(cin, fecha);

            while (!validar_fecha(fecha)) {

                cout << "Fecha incorrecta. Ingrese una fecha real." << endl;
                cout << "Nueva fecha de nacimiento (DD/MM/AAAA): ";
                getline(cin, fecha);
            }

            personas[i].fecha = fecha;

            cout << "Nuevo CI: ";
            getline(cin, personas[i].ci);

            cout << "Nueva direccion: ";
            getline(cin, personas[i].direccion);

            cout << "Nuevo telefono: ";
            getline(cin, personas[i].telefono);

            cout << "Persona modificada correctamente." << endl;
            return;
        }
    }

    cout << "Persona no encontrada." << endl;
}


// MENU DE PERSONAS
void menu_personas() {

    while (true) {

        cout << "\n===== MENU DE PERSONAS =====" << endl;
        cout << "1. Registrar persona" << endl;
        cout << "2. Listar personas" << endl;
        cout << "3. Modificar persona" << endl;
        cout << "4. Borrar persona" << endl;
        cout << "5. Cerrar sesion" << endl;

        string op;

        cout << "Seleccione una opcion: ";
        getline(cin, op);

        if (op == "1") {
            registrar_persona();
        }
        else if (op == "2") {
            listar_personas();
        }
        else if (op == "3") {
            modificar_persona();
        }
        else if (op == "4") {
            borrar_persona();
        }
        else if (op == "5") {

            cout << "Sesion cerrada." << endl;
            break;
        }
        else {
            cout << "Opcion incorrecta." << endl;
        }
    }
}


// MENU PRINCIPAL DE USUARIOS
void main() {

    while (true) {

        cout << "\n===== SISTEMA DE LOGIN =====" << endl;
        cout << "1. Registrar usuario tradicional" << endl;
        cout << "2. Registrar con cuenta de Gmail" << endl;
        cout << "3. Listar usuarios" << endl;
        cout << "4. Modificar usuario" << endl;
        cout << "5. Borrar usuario" << endl;
        cout << "6. Iniciar sesion tradicional" << endl;
        cout << "7. Iniciar sesion con Gmail" << endl;
        cout << "8. Salir" << endl;

        string op;

        cout << "Seleccione una opcion: ";
        getline(cin, op);

        if (op == "1") {
            registrar_usuario(false);
        }
        else if (op == "2") {
            registrar_usuario(true);
        }
        else if (op == "3") {
            listar_usuarios();
        }
        else if (op == "4") {
            modificar_usuario();
        }
        else if (op == "5") {
            borrar_usuario();
        }
        else if (op == "6") {

            if (login(false)) {
                menu_personas();
            }
        }
        else if (op == "7") {

            if (login(true)) {
                menu_personas();
            }
        }
        else if (op == "8") {

            cout << "Gracias por utilizar el sistema." << endl;
            break;
        }
        else {
            cout << "Opcion incorrecta." << endl;
        }
    }
}


