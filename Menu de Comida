#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float Hamburguesa=0,Hamburguesaconqueso=0,Papasfritas=0,Soda=0,total,cantidad,numero;
    int opcion, cantham=0, canthamq=0, cantpapas=0, cantsoda=0;
    double precio=0,suma=0 ;
    do{
    cout<<"-------Menu------- "<<endl ;
    cout<<"1-Hamburguesa (3Bs): "<<endl ;
    cout<<"2-Hamburguesaconqueso (5Bs): "<<endl ;
    cout<<"3-Papasfritas (2Bs): "<<endl ;
    cout<<"4.Soda (2.5Bs): "<<endl ;
    cout<<"0.Salida"<<endl ;
    cin>>opcion ;
    switch (opcion) {
        case 1 :
            precio=3 ;
            break ;
        case 2 :
            precio=5 ;
            break ;
        case 3 :
            precio=2 ;
            break ;
        case 4 :
            precio=2.5 ;
            break ;
        case 0 :
            cout<<"Se a salido correctamente del menu!"<<endl ;
            break ;
        default:
            cout<<"Opcion invalida, vuelva a intentarlo."<<endl ;
            break ;
        }
        if (opcion>0 && opcion <=4) 
        {
            cout<<"Ingresar la cantidad: " ;
            cin>>cantidad ;
            total=precio*cantidad ;
            suma=suma+total ;
            if (opcion == 1) {
                Hamburguesa=Hamburguesa+total ;
                cantham=cantham+cantidad ; }
            else 
                if (opcion==2) {
                    Hamburguesaconqueso=Hamburguesaconqueso+total ;
                    canthamq=canthamq+cantidad ; }
                else 
                    if (opcion==3){
                    Papasfritas=Papasfritas+total ;
                    cantpapas=cantpapas+cantidad ; }
                    else
                        if (opcion==4) {
                            Soda=Soda+total ;
                            cantsoda=cantsoda+cantidad ; }
        }
    } while(opcion!=0) ; 
    cout<<"   ITEM                CANTIDAD      TOTAL    PARCIAL"<<endl ;
    cout<<"Hamburguesas            (3bs)"<<"\t\t"<<cantham<<"\t"<<Hamburguesa<<endl ;
    cout<<"Hamburguesas con queso  (5bs)"<<"\t\t"<<canthamq<<"\t"<<Hamburguesaconqueso<<endl ;
    cout<<"Papas fritas            (2bs)"<<"\t\t"<<cantpapas<<"\t"<<Papasfritas<<endl ;
    cout<<"Soda                  (2.5bs)"<<"\t\t"<<cantsoda<<"\t"<<Soda<<endl ;
    cout<<"TOTAL  "<<"          \t\t\t"<<cantham+canthamq+cantpapas+cantsoda<<"\t"<<suma<<endl ;
    return 0;
}
