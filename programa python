            print("Fecha de nacimiento:", personas[i][1])
            print("CI:", personas[i][2])
            print("Direccion:", personas[i][3])
            print("Telefono:", personas[i][4])


# BORRAR PERSONA
def borrar_persona():
    print("\n--- BORRAR PERSONA ---")
    ci = input("Ingrese el CI: ")

    for p in personas:
        if p[2] == ci:
            personas.remove(p)
            print("Persona eliminada correctamente.")
